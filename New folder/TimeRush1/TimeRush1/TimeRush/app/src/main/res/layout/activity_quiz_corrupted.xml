<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_main"
    android:padding="20dp">

    <!-- Top Row: Progress text + Timer -->
    <LinearLayout
        android:id="@+id/top_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Subject Tag -->
        <TextView
            android:id="@+id/tv_subject"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Biology"
            android:textSize="13sp"
            android:fontFamily="sans-serif"
            android:textColor="#FFFFFF"
            android:background="@drawable/tag_subject"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp" />

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

        <!-- Timer Circle -->
        <androidx.cardview.widget.CardView
            android:layout_width="60dp"
            android:layout_height="60dp"
            app:cardCornerRadius="30dp"
            app:cardBackgroundColor="#1A2744"
            app:cardElevation="6dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_timer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="15"
                    android:textSize="24sp"
                    android:fontFamily="sans-serif"
                    android:textColor="#2ED573" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- Progress Text -->
    <TextView
        android:id="@+id/tv_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Question 1/10"
        android:textSize="13sp"
        android:fontFamily="sans-serif"
        android:textColor="#8899CC"
        android:layout_marginTop="14dp"
        app:layout_constraintTop_toBottomOf="@id/top_row"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="8dp"
        android:progressDrawable="@drawable/progress_bar_drawable"
        android:max="10"
        android:progress="1"
        app:layout_constraintTop_toBottomOf="@id/tv_progress"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Timer Bar -->
    <ProgressBar
        android:id="@+id/timer_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="6dp"
        android:progressDrawable="@drawable/timer_bar_drawable"
        android:max="15000"
        android:progress="15000"
        app:layout_constraintTop_toBottomOf="@id/progress_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Motivational text -->
    <TextView
        android:id="@+id/tv_motivation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Keep going! 🔥"
        android:textSize="12sp"
        android:fontFamily="sans-serif"
        android:textColor="#6C8BC7"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/timer_bar"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Question Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_question"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="24dp"
        app:cardBackgroundColor="#1A2744"
        app:cardElevation="12dp"
        app:layout_constraintTop_toBottomOf="@id/tv_motivation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tv_question"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp"
            android:text="What is the powerhouse of the cell?"
            android:textSize="20sp"
            android:fontFamily="sans-serif"
            android:textColor="#FFFFFF"
            android:lineSpacingMultiplier="1.3"
            android:gravity="center" />
    </androidx.cardview.widget.CardView>

    <!-- Options Grid -->
    <GridLayout
        android:id="@+id/options_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:rowCount="2"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/card_question"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btn_option1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="6dp"
            android:background="@drawable/btn_option"
            android:textColor="#1A1A2E"
            android:fontFamily="sans-serif"
            android:textSize="14sp"
            android:padding="16dp"
            android:text="Option 1" />

        <Button
            android:id="@+id/btn_option2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="6dp"
            android:background="@drawable/btn_option"
            android:textColor="#1A1A2E"
            android:fontFamily="sans-serif"
            android:textSize="14sp"
            android:padding="16dp"
            android:text="Option 2" />

        <Button
            android:id="@+id/btn_option3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="6dp"
            android:background="@drawable/btn_option"
            android:textColor="#1A1A2E"
            android:fontFamily="sans-serif"
            android:textSize="14sp"
            android:padding="16dp"
            android:text="Option 3" />

        <Button
            android:id="@+id/btn_option4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="6dp"
            android:background="@drawable/btn_option"
            android:textColor="#1A1A2E"
            android:fontFamily="sans-serif"
            android:textSize="14sp"
            android:padding="16dp"
            android:text="Option 4" />
    </GridLayout>

    <!-- Navigation Buttons Container -->
    <LinearLayout
        android:id="@+id/navigation_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/options_grid"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Previous Button -->
        <Button
            android:id="@+id/btn_previous"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="← PREV"
            android:textSize="14sp"
            android:fontFamily="sans-serif"
            android:letterSpacing="0.06"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_outline"
            android:layout_marginEnd="8dp"
            android:visibility="gone" />

        <!-- Unvisited Questions Button -->
        <Button
            android:id="@+id/btn_unvisited"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="SKIP UNVISITED"
            android:textSize="12sp"
            android:fontFamily="sans-serif"
            android:letterSpacing="0.04"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_outline"
            android:layout_marginHorizontal="8dp" />

        <!-- Exit Quiz Button -->
        <Button
            android:id="@+id/btn_exit"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="EXIT"
            android:textSize="14sp"
            android:fontFamily="sans-serif"
            android:letterSpacing="0.06"
            android:textColor="#FF4757"
            android:background="@drawable/btn_outline"
            android:layout_marginStart="8dp" />

    </LinearLayout>

<!-- Options Grid -->
