    android:orientation="horizontal"
    android:layout_marginTop="16dp"
    app:layout_constraintTop_toBottomOf="@id/options_grid"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent">

    <!-- Previous Button -->
    <Button
        android:id="@+id/btn_previous"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_weight="1"
        android:text="&#8592; PREV"
        android:textSize="14sp"
        android:fontFamily="sans-serif"
        android:letterSpacing="0.06"
        android:textColor="#FFFFFF"
        android:background="@drawable/btn_outline"
        android:layout_marginEnd="8dp"
        android:visibility="gone" />

    <!-- Unvisited Questions Button -->
    <Button
        android:id="@+id/btn_unvisited"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_weight="1"
        android:text="SKIP UNVISITED"
        android:textSize="12sp"
        android:fontFamily="sans-serif"
        android:letterSpacing="0.04"
        android:textColor="#FFFFFF"
        android:background="@drawable/btn_outline"
        android:layout_marginHorizontal="8dp" />

    <!-- Exit Quiz Button -->
    <Button
        android:id="@+id/btn_exit"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_weight="1"
        android:text="EXIT"
        android:textSize="14sp"
        android:fontFamily="sans-serif"
        android:letterSpacing="0.06"
        android:textColor="#FF4757"
        android:background="@drawable/btn_outline"
        android:layout_marginStart="8dp" />

</LinearLayout>

<!-- Next Button -->
<Button
    android:id="@+id/btn_next"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:text="NEXT &#8594;"
    android:textSize="16sp"
    android:fontFamily="sans-serif"
    android:letterSpacing="0.06"
    android:textColor="#0D1B3E"
    android:background="@drawable/btn_start"
    android:layout_marginTop="8dp"
    android:visibility="gone"
    app:layout_constraintTop_toBottomOf="@id/navigation_container"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
