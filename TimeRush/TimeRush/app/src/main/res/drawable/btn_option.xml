<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="4dp">
                <shape android:shape="rectangle">
                    <corners android:radius="18dp" />
                    <solid android:color="#2D4068" />
                    <stroke android:width="2dp" android:color="#4A7CE8" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <!-- 3D Shadow -->
            <item android:top="4dp">
                <shape android:shape="rectangle">
                    <corners android:radius="18dp" />
                    <solid android:color="#121A2F" />
                </shape>
            </item>
            <!-- Button Face -->
            <item android:bottom="4dp">
                <shape android:shape="rectangle">
                    <corners android:radius="18dp" />
                    <solid android:color="#263659" />
                    <stroke android:width="2dp" android:color="#3A4F82" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
