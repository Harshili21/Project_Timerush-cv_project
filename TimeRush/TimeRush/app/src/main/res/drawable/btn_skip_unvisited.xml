<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="4dp">
                <shape android:shape="rectangle">
                    <corners android:radius="30dp" />
                    <solid android:color="#2C28A0" />
                </shape>
            </item>
        </layer-list>
    </item>
    <!-- Default state -->
    <item>
        <layer-list>
            <!-- Shadow -->
            <item android:top="4dp">
                <shape android:shape="rectangle">
                    <corners android:radius="30dp" />
                    <solid android:color="#1A1660" />
                </shape>
            </item>
            <!-- Face -->
            <item android:bottom="4dp">
                <shape android:shape="rectangle">
                    <corners android:radius="30dp" />
                    <gradient
                        android:angle="90"
                        android:startColor="#4A45DB"
                        android:endColor="#6A5FED"
                        android:type="linear" />
                    <stroke android:width="1dp" android:color="#8B80FF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
